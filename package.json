{
  "name": "hi-streets-app",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "test": "npm run test:unit",
    "test:unit": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:auth": "playwright test --config playwright-auth.config.ts",
    "check": "npm run test:unit && npm run build",
    "start": "vite preview --host 0.0.0.0 --port ${PORT:-3000}",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "seed:boundary": "tsx scripts/import-newham-boundary.ts",
    "mobile:sync": "node scripts/prepare-mobile.mjs",
    "mobile:preview": "node scripts/prepare-mobile.mjs --preview",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "mobile:assets": "capacitor-assets generate --android --ios --assetPath assets --iconBackgroundColor '#EF6C34' --iconBackgroundColorDark '#EF6C34' --splashBackgroundColor '#063b3a' --splashBackgroundColorDark '#063b3a'",
    "test:reports": "node scripts/test-mobile-reports.mjs",
    "test:safety": "playwright test --config playwright-safety.config.ts",
    "test:feedback": "node scripts/test-feedback.mjs",
    "test:feedback-email": "node scripts/test-feedback-email.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/splash-screen": "8.0.2",
    "@supabase/supabase-js": "2.112.3",
    "lucide-react": "0.468.0",
    "maplibre-gl": "6.4.1",
    "proj4": "2.21.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.62.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
